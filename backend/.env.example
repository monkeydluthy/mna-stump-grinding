# Admin login (required for /login) - never commit real values
ADMIN_PASSWORD=your_secure_password_here
ALLOWED_EMAILS=admin@example.com,other@example.com

# Server
PORT=5001
FRONTEND_URL=http://localhost:3000

# Google Places (server-side only — used by Netlify reviews-google function)
# Never prefix these with VITE_ (that would expose them to the browser).
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Google Business Profile reviews (server-side only). Create a Web OAuth client
# with redirect URI https://mnastumpgrinding.com/api/google-business/callback
# then open /api/google-business/connect once and save the refresh token here.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# GOOGLE_BUSINESS_PARENT=accounts/000/locations/000

# Optional: Supabase migration / local scripts
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=

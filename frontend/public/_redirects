# Apex host consolidation — keep in sync with [[redirects]] in netlify.toml
# www → non-www (GBP Website field). Path + query string are preserved.
https://www.mnastumpgrinding.com/*  https://mnastumpgrinding.com/:splat  301!

# API routes - must come before the catch-all
/api/reviews/google /.netlify/functions/reviews-google 200!
/api/portfolio /.netlify/functions/portfolio 200!
/api/auth/* /.netlify/functions/auth 200!
/api/upload /.netlify/functions/upload 200!
/api/health-check /.netlify/functions/health-check 200!
/api/analytics /.netlify/functions/analytics 200!

# Known SPA routes
/              /index.html  200
/portfolio     /index.html  200
/login         /index.html  200
/admin         /index.html  200
/admin/*       /index.html  200

# Everything else is a real 404
/*             /404.html    404
